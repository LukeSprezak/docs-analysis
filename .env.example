PROJECT_NAME=docsAnalysis
API_V1_STR=/api/v1
# LLM Provider: openai, anthropic, google, ollama
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# Vector store: postgres (pgvector, default), faiss (in-memory, for local development
# and testing) or neo4j (native vector index; the only one that also stores a graph)
VECTOR_STORE_PROVIDER=postgres
# Backing store for documents/summaries/conversations/users. Currently: postgres.
PERSISTENCE_PROVIDER=postgres
# Knowledge graph: none (off — no entity extraction on upload, retrieval stays
# vector-only) or neo4j. Requires the NEO4J_* settings below when enabled.
KNOWLEDGE_GRAPH_PROVIDER=none

RERANKER_PROVIDER=none
RETRIEVAL_CANDIDATE_COUNT=20
RETRIEVAL_TOP_K=4
RETRIEVAL_STRATEGY=vector
# Required when
COHERE_API_KEY=your_cohere_api_key_here
COHERE_RERANK_MODEL=rerank-v3.5
# Used when RERANKER_PROVIDER=bge (local cross-encoder)
BGE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

EVAL_JUDGE_PROVIDER=none
EVAL_DATASET_PATH=eval/golden_set.json
# API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
OLLAMA_BASE_URL=http://localhost:11434
# Auth (JWT). In production, set your own long (>=32 characters) random secret —
# the default in the code is explicitly not intended for production use. ACCESS_TOKEN_EXPIRE_MINUTES = token lifetime.
JWT_SECRET_KEY=change-me-to-a-long-random-secret-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

CORS_ALLOWED_ORIGINS=http://localhost:3000

RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_LLM=20/minute
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_AUTH=5/minute

LOG_LEVEL=INFO
LOG_FORMAT=TEXT
LOG_FILE=storage/logs/app.log
# Database settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_change_me
POSTGRES_DB=docs_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Call pool (SQLAlchemy async engine)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
# Pagination list
LIST_DEFAULT_LIMIT=50
LIST_MAX_LIMIT=100

MAX_UPLOAD_SIZE_MB=20
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.txt,.md

# Graph database (Neo4j). Required when VECTOR_STORE_PROVIDER=neo4j; the factory checks
# them at startup and fails loudly if one is missing. The username is fixed to `neo4j` on
# the community edition. Use bolt://localhost:7687 when running against the container from
# the host instead of from inside the compose network.
NEO4J_PASSWORD=neo4j_password_change_me
NEO4J_URI=bolt://graph:7687
NEO4J_USERNAME=neo4j
