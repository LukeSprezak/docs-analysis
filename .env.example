# LLM Provider: openai, anthropic, google, ollama
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Vector store: postgres (pgvector, domyślny) lub faiss (w pamięci, do lokalnego dev/testów)
VECTOR_STORE_PROVIDER=postgres

# API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# Database settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_change_me
POSTGRES_DB=docs_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
